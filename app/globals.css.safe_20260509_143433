@tailwind base;
@tailwind components;
@tailwind utilities;

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #020617;
}

/* Emergency visibility fix */
html,
body {
  background: #07111f !important;
  color: #f6f8fb !important;
}

main,
section,
div,
p,
h1,
h2,
h3,
h4,
h5,
h6,
label,
span,
li {
  color: inherit;
}

p,
li,
label {
  color: #c8d3e3 !important;
}

h1,
h2,
h3 {
  color: #ffffff !important;
}

a {
  color: #57d3ff !important;
}

input,
textarea,
select {
  background: #081827 !important;
  color: #ffffff !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
}

button,
.submitBtn,
.primaryBtn {
  background: linear-gradient(135deg, #57d3ff, #a8ffbf) !important;
  color: #06111d !important;
}

.adminPage,
.hero,
.section,
.formSection {
  background: #07111f !important;
}

.auditForm,
.heroCard,
.adminPanel,
.leadCard,
.reportBox,
.followupBox {
  background: rgba(255,255,255,0.07) !important;
  border: 1px solid rgba(255,255,255,0.14) !important;
}


/* Form layout fix */
.formSection {
  padding: 96px 0 !important;
}

.formGrid {
  display: grid !important;
  grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr) !important;
  gap: 40px !important;
  align-items: start !important;
}

.auditForm {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 18px !important;
  width: 100% !important;
  padding: 28px !important;
  border-radius: 24px !important;
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.16) !important;
  box-shadow: 0 24px 80px rgba(0,0,0,0.28) !important;
}

.auditForm label {
  display: flex !important;
  flex-direction: column !important;
  gap: 8px !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  color: #f6f8fb !important;
}

.auditForm input,
.auditForm select,
.auditForm textarea {
  width: 100% !important;
  min-height: 46px !important;
  padding: 12px 14px !important;
  border-radius: 14px !important;
  background: rgba(7,17,31,0.92) !important;
  color: #ffffff !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
  outline: none !important;
  font-size: 15px !important;
}

.auditForm textarea {
  min-height: 108px !important;
  resize: vertical !important;
}

.auditForm label:has(textarea),
.auditForm .full,
.auditForm button,
.auditForm p {
  grid-column: 1 / -1 !important;
}

.auditForm button {
  min-height: 52px !important;
  border: 0 !important;
  border-radius: 16px !important;
  font-size: 16px !important;
  font-weight: 800 !important;
  cursor: pointer !important;
  background: linear-gradient(135deg, #57d3ff, #a8ffbf) !important;
  color: #06111d !important;
}

.auditForm button:disabled {
  opacity: 0.65 !important;
  cursor: not-allowed !important;
}

.auditForm p {
  margin: 0 !important;
  color: #aebbd0 !important;
  line-height: 1.6 !important;
}

.container {
  width: min(1120px, calc(100% - 40px)) !important;
  margin: 0 auto !important;
}

.hero,
.section {
  padding-left: 0 !important;
  padding-right: 0 !important;
}

@media (max-width: 860px) {
  .formGrid {
    grid-template-columns: 1fr !important;
  }

  .auditForm {
    grid-template-columns: 1fr !important;
  }
}


/* Professional admin report */
.professionalReport {
  display: grid !important;
  gap: 22px !important;
}

.kpiGrid {
  display: grid !important;
  grid-template-columns: repeat(5, minmax(140px, 1fr)) !important;
  gap: 14px !important;
}

.kpiCard {
  padding: 18px !important;
  border-radius: 18px !important;
  background: rgba(255,255,255,0.075) !important;
  border: 1px solid rgba(255,255,255,0.13) !important;
}

.kpiCard span {
  display: block !important;
  margin-bottom: 8px !important;
  color: #aebbd0 !important;
  font-size: 13px !important;
}

.kpiCard b {
  color: #ffffff !important;
  font-size: 22px !important;
}

.reportSections {
  display: grid !important;
  gap: 20px !important;
}

.reportSectionCard {
  padding: 22px !important;
  border-radius: 22px !important;
  background: rgba(7,17,31,0.72) !important;
  border: 1px solid rgba(255,255,255,0.13) !important;
}

.sectionTitleRow {
  display: flex !important;
  justify-content: space-between !important;
  gap: 16px !important;
  align-items: center !important;
  margin-bottom: 10px !important;
}

.sectionTitleRow h3 {
  margin: 0 !important;
  color: #ffffff !important;
  font-size: 22px !important;
}

.sectionTitleRow span {
  padding: 6px 10px !important;
  border-radius: 999px !important;
  background: rgba(87,211,255,0.14) !important;
  color: #57d3ff !important;
  font-size: 13px !important;
  white-space: nowrap !important;
}

.sectionSummary {
  margin: 0 0 16px !important;
  color: #c8d3e3 !important;
  line-height: 1.7 !important;
}

.issueList {
  display: grid !important;
  gap: 14px !important;
}

.issueCard {
  padding: 18px !important;
  border-radius: 18px !important;
  background: rgba(255,255,255,0.055) !important;
  border: 1px solid rgba(255,255,255,0.11) !important;
}

.issueTop {
  display: flex !important;
  justify-content: space-between !important;
  gap: 12px !important;
  align-items: center !important;
  margin-bottom: 12px !important;
}

.issueTop b {
  color: #ffffff !important;
  font-size: 17px !important;
}

.issueTop span {
  padding: 5px 9px !important;
  border-radius: 999px !important;
  font-size: 12px !important;
  white-space: nowrap !important;
}

.severity-high .issueTop span {
  background: rgba(255,99,99,0.16) !important;
  color: #ff9b9b !important;
}

.severity-medium .issueTop span {
  background: rgba(255,205,86,0.16) !important;
  color: #ffe08a !important;
}

.severity-low .issueTop span {
  background: rgba(168,255,191,0.14) !important;
  color: #a8ffbf !important;
}

.issueCard p {
  margin: 8px 0 0 !important;
  color: #c8d3e3 !important;
  line-height: 1.65 !important;
}

.issueCard strong {
  color: #ffffff !important;
}

@media (max-width: 980px) {
  .kpiGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 640px) {
  .kpiGrid {
    grid-template-columns: 1fr !important;
  }

  .issueTop,
  .sectionTitleRow {
    align-items: flex-start !important;
    flex-direction: column !important;
  }
}

