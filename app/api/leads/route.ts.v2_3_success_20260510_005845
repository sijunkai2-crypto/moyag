async function fetchTextWithTimeout(url: string, timeoutMs = 6000): Promise<{ ok: boolean; status: number; text: string; url: string }> {
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), timeoutMs);

    const response = await fetch(url, {
      signal: controller.signal,
      headers: {
        'user-agent': 'Mozilla/5.0 Moyag SEO Audit Bot/0.1'
      }
    });

    clearTimeout(timeout);

    const text = await response.text();

    return {
      ok: response.ok,
      status: response.status,
      text,
      url: response.url || url
    };
  } catch {
    return {
      ok: false,
      status: 0,
      text: '',
      url
    };
  }
}

async function inspectPublicSeoFiles(finalUrl: string) {
  const parsed = new URL(finalUrl);
  const origin = parsed.origin;
  const usesHttps = parsed.protocol === 'https:';

  const robotsUrl = `${origin}/robots.txt`;
  const sitemapUrl = `${origin}/sitemap.xml`;

  const robotsResponse = await fetchTextWithTimeout(robotsUrl, 6000);
  const robotsText = robotsResponse.text || '';
  const robotsExists = robotsResponse.ok && robotsText.trim().length > 0;
  const robotsBlocksAll = /disallow\s*:\s*\/\s*$/im.test(robotsText);
  const robotsHasSitemap = /sitemap\s*:/i.test(robotsText);

  const sitemapResponse = await fetchTextWithTimeout(sitemapUrl, 6000);
  const sitemapText = sitemapResponse.text || '';
  const sitemapExists = sitemapResponse.ok && /<urlset|<sitemapindex|<loc>/i.test(sitemapText);
  const sitemapUrlCount = sitemapExists ? (sitemapText.match(/<loc>/gi) || []).length : 0;

  return {
    homepageStatus: 200,
    usesHttps,
    robotsTxt: {
      exists: robotsExists,
      status: robotsResponse.status,
      blocksAll: robotsBlocksAll,
      hasSitemap: robotsHasSitemap,
      url: robotsUrl
    },
    sitemap: {
      exists: sitemapExists,
      status: sitemapResponse.status,
      urlCount: sitemapUrlCount,
      url: sitemapUrl
    }
  };
}


async function generateSeoReport(website: string): Promise<any> {
  const generatedAt = new Date().toISOString();

  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 9000);
    const response = await fetch(website, {
      signal: controller.signal,
      headers: {
        'user-agent': 'Mozilla/5.0 Moyag SEO Audit Bot/0.1'
      }
    });
    clearTimeout(timeout);

    const html = await response.text();
    const finalUrl = response.url || website;
    const technical = await inspectPublicSeoFiles(finalUrl);
    technical.homepageStatus = response.status;
    const title = getTagContent(html, 'title');
    const description = getMetaContent(html, 'description');
    const h1 = getAllTagContent(html, 'h1');
    const canonical = getLinkHref(html, 'canonical');
    const robots = getMetaContent(html, 'robots');
    const viewport = getMetaContent(html, 'viewport');
    const imageTags = [...html.matchAll(/<img\b[^>]*>/gi)].map((match) => match[0]);
    const imageCount = imageTags.length;
    const imagesWithoutAlt = imageTags.filter((img) => !getAttribute(img, 'alt')).length;
    const { internalLinks, externalLinks } = countLinks(html, finalUrl);
    const visibleText = stripHtml(html).toLowerCase();
    const hasContactSignal = /contact|quote|inquiry|enquiry|whatsapp|email|request|rfq|咨询|联系/i.test(visibleText);

    const checks: SeoReport['checks'] = [];

    checks.push(
      title
        ? makeCheck(
            'Title 标题',
            title.length >= 30 && title.length <= 65 ? 'good' : 'warning',
            `检测到标题：${title}（${title.length} 字符）`,
            title.length >= 30 && title.length <= 65
              ? '标题长度基本合适，后续需要加入核心产品词和目标市场词。'
              : '建议将 Title 控制在 30-65 字符，并前置核心产品关键词。'
          )
        : makeCheck('Title 标题', 'bad', '未检测到页面 Title。', '需要为首页添加清晰的英文 Title，包含产品、用途和品牌。')
    );

    checks.push(
      description
        ? makeCheck(
            'Meta Description',
            description.length >= 70 && description.length <= 160 ? 'good' : 'warning',
            `检测到描述：${description}（${description.length} 字符）`,
            description.length >= 70 && description.length <= 160
              ? '描述长度基本合适，建议继续强化询盘理由和差异化卖点。'
              : '建议将描述控制在 70-160 字符，并写清产品、应用、认证、交付能力。'
          )
        : makeCheck('Meta Description', 'bad', '未检测到 Meta Description。', '需要补充首页描述，用于提升 Google 搜索摘要点击率。')
    );

    checks.push(
      h1.length === 1
        ? makeCheck('H1 主标题', 'good', `检测到 1 个 H1：${h1[0]}`, 'H1 数量合理，后续可检查是否包含核心产品词。')
        : h1.length === 0
          ? makeCheck('H1 主标题', 'bad', '未检测到 H1。', '首页需要 1 个清晰 H1，说明主营产品和目标客户。')
          : makeCheck('H1 主标题', 'warning', `检测到 ${h1.length} 个 H1。`, '建议首页只保留 1 个 H1，其余主标题改为 H2/H3。')
    );

    checks.push(
      viewport
        ? makeCheck('移动端适配', 'good', '检测到 viewport 标签。', '移动端基础适配存在，后续需用真机检查首屏转化。')
        : makeCheck('移动端适配', 'warning', '未检测到 viewport 标签。', '建议添加 viewport，避免移动端展示异常。')
    );

    checks.push(
      canonical
        ? makeCheck('Canonical', 'good', `检测到 canonical：${canonical}`, '规范链接存在，可减少重复页面风险。')
        : makeCheck('Canonical', 'warning', '未检测到 canonical。', '建议为核心页面添加 canonical，尤其是多语言或多参数页面。')
    );

    checks.push(
      imageCount > 0
        ? makeCheck(
            '图片 Alt',
            imagesWithoutAlt === 0 ? 'good' : 'warning',
            `检测到 ${imageCount} 张图片，其中 ${imagesWithoutAlt} 张缺少 alt。`,
            imagesWithoutAlt === 0
              ? '图片 alt 基础良好，后续可加入产品词和应用场景词。'
              : '建议为产品图、工厂图、案例图添加英文 alt，帮助图片 SEO 和页面语义。'
          )
        : makeCheck('图片 Alt', 'warning', '首页未检测到图片。', 'B2B 官网建议补充产品、工厂、应用场景图片，并配置 alt。')
    );

    checks.push(
      internalLinks >= 5
        ? makeCheck('内链结构', 'good', `检测到约 ${internalLinks} 个内部链接。`, '内链基础可用，后续可增加产品分类、案例、博客之间的语义链接。')
        : makeCheck('内链结构', 'warning', `检测到约 ${internalLinks} 个内部链接。`, '建议增加产品分类页、应用页、案例页、联系我们页之间的内链。')
    );

    checks.push(
      hasContactSignal
        ? makeCheck('询盘入口', 'good', '首页检测到联系、询盘或报价相关信号。', '后续可优化按钮位置和表单字段，降低客户提交阻力。')
        : makeCheck('询盘入口', 'warning', '首页未明显检测到联系/询盘/报价信号。', '建议在首屏和产品区增加 Request a Quote / Contact Us / WhatsApp 入口。')
    );

    if (robots && /noindex/i.test(robots)) {
      checks.push(makeCheck('Robots 索引', 'bad', `检测到 robots：${robots}`, '页面可能禁止 Google 收录，需要立即检查。'));
    } else {
      checks.push(makeCheck('Robots 索引', 'good', robots ? `检测到 robots：${robots}` : '未检测到 noindex。', '暂未发现明显禁止收录信号。'));
    }

    checks.push(
      technical.usesHttps
        ? makeCheck('HTTPS 安全访问', 'good', '官网使用 HTTPS 访问。', 'HTTPS 基础正常，利于用户信任和浏览器安全展示。')
        : makeCheck('HTTPS 安全访问', 'bad', '官网当前不是 HTTPS 访问。', '建议启用 HTTPS 并将 HTTP 统一 301 跳转到 HTTPS，避免浏览器安全提示和信任损耗。')
    );

    checks.push(
      technical.homepageStatus === 200
        ? makeCheck('首页 HTTP 状态', 'good', `首页返回状态码 ${technical.homepageStatus}。`, '首页可正常访问，Google 抓取基础正常。')
        : makeCheck('首页 HTTP 状态', 'bad', `首页返回状态码 ${technical.homepageStatus || '未知'}。`, '建议检查服务器、重定向、防火墙或 CDN 配置，确保首页稳定返回 200。')
    );

    checks.push(
      technical.robotsTxt.blocksAll
        ? makeCheck('robots.txt 抓取规则', 'bad', 'robots.txt 存在 Disallow: /，可能阻止全站抓取。', '需要立即检查 robots.txt，避免阻止 Google 抓取核心页面。')
        : technical.robotsTxt.exists
          ? makeCheck(
              'robots.txt 抓取规则',
              technical.robotsTxt.hasSitemap ? 'good' : 'warning',
              `robots.txt 可访问，状态码 ${technical.robotsTxt.status}，${technical.robotsTxt.hasSitemap ? '已包含 Sitemap 声明' : '未发现 Sitemap 声明'}。`,
              technical.robotsTxt.hasSitemap
                ? 'robots.txt 基础良好，后续可继续检查是否屏蔽重要目录。'
                : '建议在 robots.txt 中声明 Sitemap 地址，帮助 Google 更快发现核心页面。'
            )
          : makeCheck('robots.txt 抓取规则', 'warning', `未能访问 robots.txt，状态码 ${technical.robotsTxt.status || '未知'}。`, '建议补充 robots.txt，用于管理搜索引擎抓取规则并声明 Sitemap。')
    );

    checks.push(
      technical.sitemap.exists
        ? makeCheck(
            'sitemap.xml 站点地图',
            technical.sitemap.urlCount >= 5 ? 'good' : 'warning',
            `sitemap.xml 可访问，检测到约 ${technical.sitemap.urlCount} 个 URL。`,
            technical.sitemap.urlCount >= 5
              ? '站点地图基础可用，后续可检查是否覆盖产品页、案例页和重点 SEO 页面。'
              : '站点地图 URL 数量偏少，建议确认是否覆盖核心产品页、行业页、案例页和联系页。'
          )
        : makeCheck('sitemap.xml 站点地图', 'bad', `未能检测到有效 sitemap.xml，状态码 ${technical.sitemap.status || '未知'}。`, '建议创建 sitemap.xml 并提交到 Google Search Console，帮助核心页面被发现和索引。')
    );

    const score = Math.max(0, Math.min(100, Math.round(checks.reduce((sum, check) => {
      if (check.status === 'good') return sum + 11;
      if (check.status === 'warning') return sum + 6;
      return sum + 1;
    }, 0))));

    const warningCount = checks.filter((check) => check.status === 'warning').length;
    const badCount = checks.filter((check) => check.status === 'bad').length;

    return {
      status: 'completed',
      generatedAt,
      summary: `初步检测完成：得分 ${score}/100，发现 ${warningCount} 个可优化项，${badCount} 个高优先级问题。`,
      score,
      checks,
      page: {
        finalUrl,
        title,
        titleLength: title.length,
        description,
        descriptionLength: description.length,
        h1,
        h1Count: h1.length,
        canonical,
        robots,
        viewport,
        imageCount,
        imagesWithoutAlt,
        internalLinks,
        externalLinks,
        hasContactSignal,
        technical
      }
    };
  } catch (error) {
    console.error('Failed to generate SEO report:', error);
    return {
      status: 'failed',
      generatedAt,
      summary: '系统未能自动抓取该官网首页，可能是目标网站阻止访问、响应超时或 SSL 配置异常。线索已正常保存，建议人工打开官网检查。',
      score: 0,
      checks: [
        makeCheck('官网抓取', 'bad', '自动抓取失败。', '人工确认官网是否可访问，并检查是否屏蔽海外服务器或爬虫访问。')
      ],
      page: {}
    };
  }
}

function getEmailConfig() {
  const host = process.env.SMTP_HOST;
  const port = Number(process.env.SMTP_PORT || 465);
  const user = process.env.SMTP_USER;
  const pass = process.env.SMTP_PASS;
  const to = process.env.LEAD_NOTIFY_TO || user;
  const from = process.env.LEAD_NOTIFY_FROM || user;

  if (!host || !user || !pass || !to || !from) return null;

  return {
    host,
    port,
    secure: port === 465,
    auth: { user, pass },
    to,
    from
  };
}

