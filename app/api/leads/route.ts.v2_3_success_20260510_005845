async function sendLeadNotification(lead: Lead) {
  const config = getEmailConfig();

  if (!config) {
    console.warn('SMTP email notification is not configured. Lead was saved locally only.');
    return;
  }

  const transporter = nodemailer.createTransport({
    host: config.host,
    port: config.port,
    secure: config.secure,
    auth: config.auth
  });

  await transporter.sendMail({
    from: config.from,
    to: config.to,
    replyTo: lead.email,
    subject: `新 SEO 检测线索：${lead.company}｜初步得分 ${lead.report.score}/100｜跟进优先级 ${lead.followup.priority}`,
    text: buildLeadEmailText(lead),
    html: buildLeadEmailHtml(lead)
  });
}



type ProfessionalIssue = {
  title: string;
  severity: 'high' | 'medium' | 'low';
  evidence: string;
  impact: string;
  recommendation: string;
  expectedBenefit: string;
};

type ProfessionalSection = {
  title: string;
  summary: string;
  issues: ProfessionalIssue[];
};

function normalizeSeverity(status?: string): 'high' | 'medium' | 'low' {
  if (status === 'bad') return 'high';
  if (status === 'warning') return 'medium';
  return 'low';
}

function buildProfessionalIssue(
  title: string,
  severity: 'high' | 'medium' | 'low',
  evidence: string,
  impact: string,
  recommendation: string,
  expectedBenefit: string
): ProfessionalIssue {
  return { title, severity, evidence, impact, recommendation, expectedBenefit };
}

function includesAny(source: string, words: string[]) {
  const lower = source.toLowerCase();
  return words.some((word) => lower.includes(word.toLowerCase()));
}

function upgradeSeoReportForProfessionalView(report: any, input: any) {
  const checks = Array.isArray(report?.checks) ? report.checks : [];
  const page = report?.page || {};

  const company = String(input?.company || input?.companyName || '该企业').trim();
  const product = String(input?.product || input?.service || input?.mainProduct || '核心产品/服务').trim();
  const market = String(input?.market || input?.targetMarket || '目标海外市场').trim();
  const problem = String(input?.problem || input?.currentProblem || input?.message || 'Google 获客效果不稳定').trim();

  const bodyText = [
    page.title,
    page.description,
    page.h1Text,
    page.bodyText,
    page.rawText,
    ...(Array.isArray(page.h1) ? page.h1 : []),
    ...(Array.isArray(page.h2) ? page.h2 : []),
    ...(Array.isArray(page.h3) ? page.h3 : [])
  ].filter(Boolean).join(' ');

  const lowerBody = bodyText.toLowerCase();

  const productWords = product.split(/\s+|,|，|\/|、|\|/).filter((word) => word && word.length >= 2);
  const marketWords = market.split(/\s+|,|，|\/|、|\|/).filter((word) => word && word.length >= 2);

  const commercialIntentWords = [
    'supplier', 'manufacturer', 'factory', 'exporter', 'wholesale', 'custom',
    'solution', 'quote', 'inquiry', 'price', 'oem', 'odm', 'bulk',
    '供应商', '厂家', '工厂', '出口', '批发', '定制', '报价', '询盘', '采购'
  ];

  const trustWords = [
    'about', 'factory', 'certificate', 'certification', 'case', 'project',
    'faq', 'blog', 'quality', 'iso', 'ce', 'fda', 'experience',
    '关于', '工厂', '认证', '证书', '案例', '质量', '资质', '经验', '常见问题'
  ];

  const conversionWords = [
    'contact', 'inquiry', 'quote', 'form', 'email', 'phone', 'whatsapp',
    'get a quote', 'request quote', 'book a call',
    '联系', '询盘', '报价', '表单', '邮箱', '电话', '微信'
  ];

  const globalMarketWords = [
    'usa', 'us', 'america', 'europe', 'global', 'export', 'international',
    'overseas', 'worldwide', 'north america', 'eu',
    '美国', '欧洲', '海外', '全球', '出口', '国际'
  ];

  const hasProductSignal = productWords.length > 0 && includesAny(bodyText, productWords);
  const hasMarketSignal = marketWords.length > 0 && includesAny(bodyText, marketWords);
  const hasCommercialIntent = includesAny(bodyText, commercialIntentWords);
  const hasTrustSignal = includesAny(bodyText, trustWords);
  const hasConversionSignal = page.hasContactSignal === true || includesAny(bodyText, conversionWords);
  const hasGlobalSignal = includesAny(bodyText, globalMarketWords);

  const titleText = String(page.title || '').trim();
  const descriptionText = String(page.description || '').trim();
  const h1Text = String(page.h1Text || '').trim();
  const technical = page.technical || {};

  const issues: ProfessionalIssue[] = checks.map((check: any) =>
    buildProfessionalIssue(
      check.item || 'SEO 检测项',
      normalizeSeverity(check.status),
      check.finding || '系统检测到该项存在优化空间。',
      check.status === 'bad'
        ? '该问题会削弱 Google 对页面主题、业务属性和采购意图的判断，也会影响海外买家对官网专业度的第一印象。'
        : check.status === 'warning'
          ? '该问题不一定立即造成流量损失，但会降低页面完整度、搜索相关性和后续询盘转化效率。'
          : '该项基础表现可用，后续可围绕目标关键词和转化路径继续精细化提升。',
      check.recommendation || '建议结合目标产品、目标市场和询盘路径进行系统优化，而不是只做单点标签修改。',
      check.status === 'bad'
        ? '修复后可提升页面主题清晰度、Google 抓取理解效率和询盘转化基础。'
        : '优化后可增强页面稳定性、相关性和采购商信任。'
    )
  );

  if (technical.homepageStatus && technical.homepageStatus !== 200) {
    issues.push(buildProfessionalIssue(
      '首页状态码异常',
      'high',
      `首页 HTTP 状态码为 ${technical.homepageStatus}，不是标准 200。`,
      '首页状态码异常会影响 Google 抓取稳定性，也会让海外客户访问时遇到跳转、错误或加载失败。',
      '建议检查服务器、CDN、防火墙和重定向链路，确保首页长期稳定返回 200。',
      '提升 Google 抓取稳定性，减少自然流量和询盘入口损耗。'
    ));
  }

  if (technical.usesHttps === false) {
    issues.push(buildProfessionalIssue(
      'HTTPS 安全信号不足',
      'high',
      '官网未使用 HTTPS 作为最终访问协议。',
      '非 HTTPS 页面会削弱浏览器安全展示和海外采购商信任，也可能影响表单提交意愿。',
      '建议部署 SSL 证书，并将所有 HTTP 页面 301 跳转到 HTTPS。',
      '提升访问安全感、品牌可信度和表单转化基础。'
    ));
  }

  if (technical.robotsTxt?.blocksAll) {
    issues.push(buildProfessionalIssue(
      'robots.txt 可能阻止全站抓取',
      'high',
      '检测到 robots.txt 中存在 Disallow: / 规则。',
      '该规则可能导致 Google 无法抓取网站核心页面，严重影响收录和自然搜索曝光。',
      '建议立即检查 robots.txt，移除对核心页面的全站屏蔽规则，并只屏蔽无 SEO 价值目录。',
      '恢复搜索引擎抓取能力，为后续关键词排名建立基础。'
    ));
  } else if (technical.robotsTxt && technical.robotsTxt.exists === false) {
    issues.push(buildProfessionalIssue(
      'robots.txt 缺失或不可访问',
      'medium',
      `robots.txt 未能正常访问，状态码 ${technical.robotsTxt.status || '未知'}。`,
      'robots.txt 缺失不一定会阻止收录，但会降低抓取管理和 Sitemap 声明的专业度。',
      '建议创建 robots.txt，并在其中声明 sitemap.xml 地址。',
      '帮助 Google 更清晰地理解可抓取范围和站点地图位置。'
    ));
  } else if (technical.robotsTxt && technical.robotsTxt.hasSitemap === false) {
    issues.push(buildProfessionalIssue(
      'robots.txt 未声明 Sitemap',
      'medium',
      'robots.txt 可访问，但未发现 Sitemap 声明。',
      '缺少 Sitemap 声明会降低搜索引擎发现核心页面的效率，尤其不利于多产品、多页面的 B2B 官网。',
      '建议在 robots.txt 中加入 Sitemap 地址，例如 Sitemap: https://domain.com/sitemap.xml。',
      '提升核心页面被发现、抓取和索引的效率。'
    ));
  }

  if (technical.sitemap && technical.sitemap.exists === false) {
    issues.push(buildProfessionalIssue(
      'sitemap.xml 缺失或不可访问',
      'high',
      `未检测到有效 sitemap.xml，状态码 ${technical.sitemap.status || '未知'}。`,
      '没有站点地图会让 Google 更难系统发现产品页、案例页、FAQ 页和目标市场页面。',
      '建议生成 sitemap.xml，并提交到 Google Search Console。',
      '提升核心页面发现效率，为更多长尾关键词页面建立索引基础。'
    ));
  } else if (technical.sitemap && typeof technical.sitemap.urlCount === 'number' && technical.sitemap.urlCount > 0 && technical.sitemap.urlCount < 5) {
    issues.push(buildProfessionalIssue(
      'sitemap.xml 覆盖页面偏少',
      'medium',
      `sitemap.xml 中检测到约 ${technical.sitemap.urlCount} 个 URL。`,
      'B2B 官网如果只有少量 URL，通常说明产品页、应用页、案例页和 FAQ 页布局不足，长尾关键词覆盖有限。',
      '建议补充产品分类页、应用场景页、FAQ 页、案例页和联系页，并纳入 sitemap.xml。',
      '扩大 Google 可发现页面数量，提高长尾关键词获客机会。'
    ));
  }

  if (!titleText) {
    issues.push(buildProfessionalIssue(
      'Title 缺失',
      'high',
      '页面未检测到有效 Title。',
      'Title 是 Google 搜索结果中最重要的主题入口，缺失会直接影响页面被理解和点击。',
      `建议设置包含「${product}」、业务属性和目标市场的 Title，例如产品词 + supplier/manufacturer + market。`,
      '提升搜索结果相关性、点击率和核心关键词承接能力。'
    ));
  } else {
    const titleHasProduct = productWords.length === 0 || includesAny(titleText, productWords);
    const titleHasIntent = includesAny(titleText, commercialIntentWords);

    if (page.titleLength && (page.titleLength < 30 || page.titleLength > 65)) {
      issues.push(buildProfessionalIssue(
        'Title 长度与搜索展示不理想',
        'medium',
        `当前 Title 长度约 ${page.titleLength} 个字符。`,
        'Title 过短会导致主题表达不足，过长则可能在 Google 搜索结果中被截断。',
        `建议将 Title 控制在 30-65 字符，并前置核心产品词「${product}」。`,
        '提升搜索结果点击率和页面主题匹配度。'
      ));
    }

    if (!titleHasProduct || !titleHasIntent) {
      issues.push(buildProfessionalIssue(
        'Title 缺少 B2B 商业搜索意图',
        'high',
        `当前 Title 未充分体现产品词或 supplier / manufacturer / factory / exporter / quote 等商业意图。`,
        'B2B 买家通常带着明确采购目的搜索。Title 不承接商业意图，会导致页面难以匹配高价值询盘词。',
        `建议把 Title 从品牌展示型改为采购承接型，结构可参考「${product} Supplier / Manufacturer for ${market}」。`,
        '提升高意图关键词覆盖能力，让 Google 更容易把页面匹配给采购型搜索。'
      ));
    }
  }

  if (!descriptionText) {
    issues.push(buildProfessionalIssue(
      'Meta Description 缺失',
      'high',
      '页面未检测到有效 Meta Description。',
      'Meta Description 虽不是直接排名因素，但会影响搜索结果摘要、点击率和采购商第一判断。',
      `建议补充包含产品、应用场景、供应能力、目标市场和询盘引导的描述。`,
      '提升搜索结果点击率，并让潜在客户更快理解企业价值。'
    ));
  } else {
    const descriptionHasConversion = includesAny(descriptionText, commercialIntentWords) || includesAny(descriptionText, conversionWords);
    if (!descriptionHasConversion) {
      issues.push(buildProfessionalIssue(
        'Meta Description 缺少询盘转化信号',
        'medium',
        '当前 Description 更偏介绍，缺少 quote、inquiry、supplier、solution 等采购转化表达。',
        '搜索摘要如果缺少采购利益点，可能无法吸引真正有需求的海外买家点击。',
        '建议在 Description 中加入产品优势、服务市场、供应能力和明确 CTA，例如 Get Quote / Contact Us。',
        '提高 Google 搜索结果点击率和询盘意图匹配度。'
      ));
    }
  }

  if (!h1Text) {
    issues.push(buildProfessionalIssue(
      'H1 主标题信号不足',
      'high',
      '页面未检测到明确 H1 主标题。',
      'H1 是页面主题的核心结构信号，缺失会削弱 Google 对主营业务的判断。',
      `建议设置一个清晰 H1，直接表达「${product}」和服务对象，而不是只写品牌口号。`,
      '增强页面主题聚焦度，提升核心产品词的 SEO 基础。'
    ));
  } else if (productWords.length > 0 && !includesAny(h1Text, productWords)) {
    issues.push(buildProfessionalIssue(
      'H1 未明确承接主营产品',
      'medium',
      `当前 H1 未明显包含用户提交的主营产品「${product}」。`,
      '首屏主标题如果没有表达主营产品，海外买家进入页面后需要额外判断网站是否匹配需求。',
      '建议让 H1 直接表达核心产品、行业或解决方案，而不是泛泛介绍企业。',
      '提高首屏理解效率和页面主题一致性。'
    ));
  }

  if (!hasProductSignal) {
    issues.push(buildProfessionalIssue(
      '产品关键词覆盖不足',
      'high',
      `用户提交的主营产品/服务为「${product}」，但页面主体内容中相关表达不足。`,
      'Google 难以确认官网与主营产品的强相关性，海外采购商也难以快速判断企业能提供什么。',
      '在首页首屏、服务介绍、产品模块、案例模块和 FAQ 中自然加入核心产品词、应用场景词和采购意图词。',
      '提升目标产品词排名基础，并提高客户进入页面后的理解效率。'
    ));
  }

  if (!hasMarketSignal && !hasGlobalSignal) {
    issues.push(buildProfessionalIssue(
      '目标市场与出口信号不足',
      'medium',
      `用户提交的目标市场为「${market}」，但页面内容中缺少明显市场、出口或国际服务表达。`,
      '如果页面没有目标市场、语言、地区、出口服务或国际交付信号，Google 和客户都难以判断服务匹配度。',
      `建议增加面向「${market}」市场的服务描述、交付能力、案例、认证、物流或本地化表达。`,
      '增强目标市场相关性，提高海外客户信任感。'
    ));
  }

  if (!hasCommercialIntent) {
    issues.push(buildProfessionalIssue(
      '采购型关键词意图不足',
      'high',
      '页面内容中缺少 supplier、manufacturer、factory、quote、inquiry、solution 等 B2B 采购意图词。',
      '只做公司介绍容易吸引低意图流量，难以承接正在寻找供应商的采购型搜索。',
      '建议围绕“产品 + supplier/manufacturer/exporter/solution/quote”等方向重构首页和产品页文案。',
      '提高高商业价值关键词覆盖率，让自然流量更接近真实询盘。'
    ));
  }

  if (!hasTrustSignal) {
    issues.push(buildProfessionalIssue(
      '采购商信任背书不足',
      'medium',
      '页面中未明显检测到 About、Factory、Certificate、Case、FAQ、Quality 等信任内容。',
      'B2B 采购商在提交询盘前通常会判断企业资质、生产能力、交付能力和过往案例。',
      '建议增加公司实力、工厂能力、认证证书、案例、FAQ、质量控制和交付流程内容。',
      '降低海外买家的信任门槛，提高询盘提交概率。'
    ));
  }

  if (!hasConversionSignal) {
    issues.push(buildProfessionalIssue(
      '转化入口不明显',
      'high',
      '页面中未发现明显的联系、询盘、报价、表单、邮箱、电话或 WhatsApp 信号。',
      '即使获得 Google 流量，客户也可能不知道下一步如何联系你，导致访问流量沉没。',
      '建议在首屏、产品区、底部和悬浮按钮中设置明确 CTA，例如 Get Quote、Contact Us、Book a Call。',
      '提升访问到询盘的转化率。'
    ));
  }

  const issueFamilyKeyForDedupe = (issue: ProfessionalIssue) => {
    const title = String(issue.title || '');
    const evidence = String(issue.evidence || '');
    const combined = `${title} ${evidence}`.toLowerCase();

    if (/sitemap/i.test(combined) || /站点地图/.test(title)) return 'sitemap';
    if (/robots\.txt/i.test(combined) || /robots 抓取/.test(title)) return 'robots';
    if (/https/i.test(combined) || /安全/.test(title)) return 'https';
    if (/http 状态|状态码/.test(title)) return 'homepage-status';
    if (/title/i.test(combined) || /标题/.test(title)) return 'title';
    if (/description/i.test(combined) || /描述/.test(title)) return 'description';
    if (/h1/i.test(combined) || /主标题/.test(title)) return 'h1';
    if (/询盘|转化|contact|quote|whatsapp|cta/i.test(combined)) return 'conversion';
    if (/关键词|产品|市场|采购/i.test(combined)) return 'keyword';
    return title.replace(/\s+/g, '').slice(0, 32);
  };

  const severityRankForDedupe = (severity: ProfessionalIssue['severity']) => {
    if (severity === 'high') return 3;
    if (severity === 'medium') return 2;
    return 1;
  };

  const dedupedIssueMap = new Map<string, ProfessionalIssue>();

  for (const issue of issues) {
    const key = issueFamilyKeyForDedupe(issue);
    const existing = dedupedIssueMap.get(key);

    if (
      !existing ||
      severityRankForDedupe(issue.severity) > severityRankForDedupe(existing.severity) ||
      (
        severityRankForDedupe(issue.severity) === severityRankForDedupe(existing.severity) &&
        issue.title.length > existing.title.length
      )
    ) {
      dedupedIssueMap.set(key, issue);
    }
  }

  issues.length = 0;
  issues.push(...dedupedIssueMap.values());

  const highPriorityCount = issues.filter((issue) => issue.severity === 'high').length;
  const mediumPriorityCount = issues.filter((issue) => issue.severity === 'medium').length;

  const rawScore = typeof report?.score === 'number'
    ? report.score - highPriorityCount * 3 - mediumPriorityCount * 1
    : 100 - highPriorityCount * 12 - mediumPriorityCount * 6;

  const score = Math.max(35, Math.min(95, Math.round(rawScore)));
  const hasSevereIndexBlocker = issues.some((issue) =>
    issue.severity === 'high' &&
    /robots\.txt 可能阻止全站抓取|首页状态码异常/i.test(issue.title)
  );

  const hasImportantSeoGap = issues.some((issue) =>
    /sitemap\.xml 缺失|H1|Title 缺少|产品关键词覆盖不足/i.test(issue.title)
  );

  const riskLevel =
    score < 60 || hasSevereIndexBlocker
      ? '高风险'
      : score < 80 || highPriorityCount >= 3 || hasImportantSeoGap
        ? '中风险'
        : '低风险';
  const estimatedFixCycle = highPriorityCount >= 4 ? '3-6 周' : highPriorityCount >= 2 ? '2-4 周' : highPriorityCount >= 1 ? '1-2 周' : '3-7 天';

  const sectionOf = (title: string, summary: string, matcher: (issue: ProfessionalIssue) => boolean): ProfessionalSection => ({
    title,
    summary,
    issues: issues.filter(matcher)
  });

  const priorityFamilyKey = (issue: ProfessionalIssue) => {
    const title = String(issue.title || '');
    const combined = `${issue.title} ${issue.evidence}`.toLowerCase();

    if (/sitemap/i.test(combined) || /站点地图/.test(title)) return 'sitemap';
    if (/h1/i.test(combined) || /主标题/.test(title)) return 'h1';
    if (/title/i.test(combined) || /标题/.test(title)) return 'title';
    if (/产品关键词覆盖不足|产品关键词|核心产品|主营产品/i.test(combined)) return 'product-keyword';
    if (/采购型关键词|商业搜索意图|supplier|manufacturer|factory|quote|inquiry/i.test(combined)) return 'purchase-intent';
    if (/robots\.txt/i.test(combined) || /robots 抓取/.test(title)) return 'robots';
    if (/询盘|转化|contact|quote|whatsapp|cta/i.test(combined)) return 'conversion';
    if (/description/i.test(combined) || /描述/.test(title)) return 'description';
    if (/http 状态|状态码/.test(title)) return 'homepage-status';
    if (/https/i.test(combined) || /安全/.test(title)) return 'https';
    if (/canonical/i.test(combined)) return 'canonical';
    if (/alt|图片/i.test(combined)) return 'image-alt';

    return title.replace(/\s+/g, '').slice(0, 32);
  };

  const priorityFamilyRank = (family: string) => {
    const order: Record<string, number> = {
      sitemap: 100,
      h1: 98,
      title: 96,
      'product-keyword': 94,
      'purchase-intent': 92,
      robots: 80,
      conversion: 76,
      description: 72,
      'homepage-status': 70,
      https: 68,
      canonical: 55,
      'image-alt': 45
    };

    return order[family] || 10;
  };

  const priorityIssues = (() => {
    const map = new Map<string, ProfessionalIssue>();

    for (const issue of issues) {
      if (/整体 SEO 诊断结论|暂无严重问题|基础表现可用/i.test(issue.title)) continue;

      const family = priorityFamilyKey(issue);
      const existing = map.get(family);

      if (!existing || issue.severity === 'high' && existing.severity !== 'high') {
        map.set(family, issue);
      }
    }

    const preferredFamilies = [
      'sitemap',
      'h1',
      'title',
      'product-keyword',
      'purchase-intent',
      'robots',
      'conversion',
      'description',
      'homepage-status',
      'https',
      'canonical',
      'image-alt'
    ];

    const picked: ProfessionalIssue[] = [];

    for (const family of preferredFamilies) {
      const issue = map.get(family);
      if (issue && picked.length < 6) {
        picked.push(issue);
      }
    }

    if (picked.length < 6) {
      const remaining = [...map.values()]
        .filter((issue) => !picked.includes(issue))
        .sort((a, b) => {
          const severityRank = (severity: ProfessionalIssue['severity']) =>
            severity === 'high' ? 3 : severity === 'medium' ? 2 : 1;

          const priorityDiff =
            priorityFamilyRank(priorityFamilyKey(b)) -
            priorityFamilyRank(priorityFamilyKey(a));

          if (priorityDiff !== 0) return priorityDiff;

          return severityRank(b.severity) - severityRank(a.severity);
        });

      picked.push(...remaining.slice(0, 6 - picked.length));
    }

    return picked;
  })();

  const sections: ProfessionalSection[] = [
    {
      title: '执行摘要',
      summary: `${company} 当前官网 SEO 综合评分为 ${score}/100，风险等级为${riskLevel}。系统共发现 ${issues.length} 个可优化问题，其中高优先级 ${highPriorityCount} 个。结合主营产品「${product}」、目标市场「${market}」和当前问题「${problem}」来看，当前优化重点不是单纯修改标签，而是建立“Google 搜索曝光 → 专业页面承接 → 信任建立 → 询盘提交”的完整 B2B 获客路径。`,
      issues: [
        buildProfessionalIssue(
          '整体 SEO 诊断结论',
          riskLevel === '高风险' ? 'high' : riskLevel === '中风险' ? 'medium' : 'low',
          `综合评分 ${score}/100；高优先级问题 ${highPriorityCount} 个；目标市场：${market || '未填写'}；主营产品：${product || '未填写'}。`,
          '这会影响 Google 对官网主题、市场定位、产品能力和转化路径的判断，也会影响海外采购商对企业专业度的信任。',
          '建议先处理影响收录、主题识别和询盘入口的高优先级问题，再围绕产品词、市场词和采购意图词搭建内容矩阵。',
          '形成更清晰的搜索入口、更强的采购信任和更完整的线索转化路径。'
        )
      ]
    },
    sectionOf('技术 SEO', '检查影响抓取、索引、移动端体验和页面基础识别的技术项。', (i) =>
      /title|meta|canonical|robots|viewport|alt|移动|图片|description|schema|结构化/i.test(i.title + i.evidence)
    ),
    sectionOf('页面结构', '检查 H1/H2/H3、页面层级、内链和内容组织方式，判断页面是否能让 Google 和买家快速理解主营业务。', (i) =>
      /h1|h2|h3|结构|内链|标题|heading|首屏/i.test(i.title + i.evidence)
    ),
    sectionOf('内容与关键词', '检查产品词、目标市场词、采购意图词、价值主张和正文完整度。', (i) =>
      /关键词|产品|市场|内容|正文|description|Title 长度|采购|商业搜索|出口/i.test(i.title + i.evidence)
    ),
    sectionOf('转化线索', '检查 CTA、联系入口、询盘路径和销售线索信号，判断 SEO 流量能否转化为商机。', (i) =>
      /转化|联系|询盘|报价|表单|邮箱|电话|whatsapp|cta|quote|contact/i.test(i.title + i.evidence)
    ),
    {
      title: '竞争与增长机会',
      summary: `围绕「${product}」和「${market}」市场，后续 SEO 增长不应只依赖首页，而应建设产品页、应用场景页、FAQ、案例页和目标市场页面。`,
      issues: [
        buildProfessionalIssue(
          '关键词与落地页增长机会',
          'medium',
          `主营产品/服务：${product || '未填写'}；目标市场：${market || '未填写'}。`,
          '如果只优化首页，难以覆盖海外买家的多层搜索意图，例如找供应商、查参数、比价格、看认证、确认交付能力。',
          `建议围绕「${product || '核心产品'} + supplier / manufacturer / solution / price / application / ${market || 'target market'}」建设产品页、场景页、FAQ 页和案例页。`,
          '扩大长尾关键词覆盖，提高精准询盘来源，并逐步降低对广告流量的依赖。'
        )
      ]
    },
    {
      title: '优先级行动计划',
      summary: `建议按照 ${estimatedFixCycle} 的周期推进第一轮修复：先处理高优先级问题，再扩展关键词页面和内容资产。`,
      issues: priorityIssues.map((issue) => buildProfessionalIssue(
        `优先处理：${issue.title}`,
        issue.severity,
        issue.evidence,
        issue.impact,
        issue.recommendation,
        issue.expectedBenefit
      ))
    }
  ].map((section) => ({
    ...section,
    issues: section.issues.length ? section.issues : [
      buildProfessionalIssue(
        `${section.title} 暂无严重问题`,
        'low',
        '当前检测中未发现该分区的明显高风险问题。',
        '该分区基础表现可用，但仍建议后续结合真实页面、Google Search Console 和竞品继续人工复核。',
        '保持现有基础，并在后续 SEO 执行中持续优化。',
        '维持页面稳定性，并为后续增长打基础。'
      )
    ]
  }));

  return {
    ...report,
    score,
    summary: `专业诊断完成：最终评分 ${score}/100，风险等级为${riskLevel}，共发现 ${issues.length} 个可优化问题，其中高优先级 ${highPriorityCount} 个。建议按照 ${estimatedFixCycle} 完成第一轮修复。`,
    riskLevel,
    issueCount: issues.length,
    highPriorityCount,
    estimatedFixCycle,
    executiveSummary: sections[0].summary.replace(`风险等级为${riskLevel}`, `风险等级为${riskLevel}`).replace(/评分为 \d+\/100/, `评分为 ${score}/100`),
    diagnosisPositioning: 'B2B Google SEO 获客诊断',
    searchIntentAnalysis: hasCommercialIntent
      ? '页面已具备部分采购型搜索意图，但仍建议围绕 supplier、manufacturer、solution、quote 等高意图词继续强化。'
      : '页面采购型搜索意图不足，建议从展示型官网升级为可承接 Google 询盘的销售型页面。',
    b2bConversionInsight: hasConversionSignal
      ? '页面已具备基础联系或询盘信号，后续应进一步优化 CTA 位置、表单阻力、信任背书和首屏行动路径。'
      : '页面转化入口不明显，SEO 流量进入后可能无法顺利转化为询盘。建议优先补充 Contact、Quote、Inquiry、WhatsApp 或表单入口。',
    googleGrowthOpportunity: `围绕「${product}」和「${market}」建设产品页、应用页、FAQ 和案例页，可逐步扩大长尾关键词覆盖并提升精准询盘来源。`,
    recommendedServicePath: riskLevel === '高风险'
      ? '建议先做 3-6 周 SEO 基础修复与首页重构，再进入关键词页面建设。'
      : riskLevel === '中风险'
        ? '建议先做 2-4 周首页 SEO 和转化路径优化，再扩展产品与场景页面。'
        : '建议在现有基础上继续扩展长尾关键词页面和内容增长计划。',
    sections,
    checks
  };
}

export async function POST(request: Request) {
  try {
    const body = (await request.json()) as LeadPayload;

    for (const field of requiredFields) {
      if (!body[field] || String(body[field]).trim().length === 0) {
        return NextResponse.json({ message: '请填写所有必填字段。' }, { status: 400 });
      }
    }

    if (!isValidUrl(String(body.website))) {
      return NextResponse.json({ message: '官网链接格式不正确。' }, { status: 400 });
    }

    if (!isValidEmail(String(body.email))) {
      return NextResponse.json({ message: '邮箱格式不正确。' }, { status: 400 });
    }

    const report = upgradeSeoReportForProfessionalView(await generateSeoReport(String(body.website).trim()), body);

    const baseLead: Omit<Lead, 'followup'> = {
      submittedAt: new Date().toISOString(),
      status: '新提交',
      company: String(body.company).trim(),
      website: String(body.website).trim(),
      product: String(body.product).trim(),
      market: String(body.market).trim(),
      problem: String(body.problem).trim(),
      contactName: String(body.contactName).trim(),
      email: String(body.email).trim(),
      messenger: body.messenger ? String(body.messenger).trim() : '',
      note: body.note ? String(body.note).trim() : '',
      report
    };

    const lead: Lead = {
      ...baseLead,
      followup: generateFollowupPackage(baseLead)
    };

    const dataDir = path.join(process.cwd(), 'data');
    await fs.mkdir(dataDir, { recursive: true });
    await fs.appendFile(path.join(dataDir, 'leads.jsonl'), `${JSON.stringify(lead)}\n`, 'utf8');

    try {
      await sendLeadNotification(lead);
    } catch (emailError) {
      console.error('Failed to send lead notification email:', emailError);
    }

    return NextResponse.json({ ok: true, message: '提交成功。' });
  } catch (error) {
    console.error(error);
    return NextResponse.json({ message: '服务器处理失败，请稍后再试。' }, { status: 500 });
  }
}
